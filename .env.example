# Este arquivo é opcional. O ScoreFlash encontra automaticamente a configuração
# pública necessária para consultar o FlashScore.

# Opcional: uma chave NOVA da sua conta Groq para perguntas mais flexíveis.
# Nunca cole chaves em conversas, imagens ou arquivos enviados ao Git.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Necessária apenas para cartões de oportunidade de jogador. Crie uma chave
# na API-Football e cole-a somente no seu arquivo .env local.
API_FOOTBALL_API_KEY=

# Normalmente não é preciso alterar estas duas linhas.
SCOREFLASH_DATA_DIR=data
